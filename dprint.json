{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": false,
  "includes": ["**/*.md"],
  "excludes": [".direnv/**", "node_modules/**", "templates/**"],
  "markdown": {
    "emphasisKind": "underscores",
    "strongKind": "asterisks"
  },
  "toml": {
    "lineWidth": 80
  },
  "plugins": ["npm:@dprint/markdown@0.24.0", "npm:@dprint/toml@0.8.0"]
}
