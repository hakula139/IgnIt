{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": false,
  "includes": ["**/*.md"],
  "excludes": [".direnv/**", "node_modules/**", "templates/**", "**/public/**", "**/themes/**"],
  "markdown": {
    "emphasisKind": "underscores",
    "strongKind": "asterisks"
  },
  "plugins": ["npm:@dprint/markdown@0.24.0"]
}
